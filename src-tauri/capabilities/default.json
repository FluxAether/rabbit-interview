{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main app + floating copilot + plugins",
  "windows": ["main", "copilot"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    "dialog:default",
    "global-shortcut:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "store:default"
  ]
}
