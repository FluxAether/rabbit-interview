# Desktop and landing. BYOK provider keys are configured in Settings and stored
# encrypted in local SQLite; the hosted refresh token uses the OS secure store.
TAURI_DEV_HOST=
VITE_HOSTED_GATEWAY_URL=http://localhost:8787

# Hosted gateway. Do not commit real values from a deployed environment.
GATEWAY_LISTEN_ADDR=127.0.0.1:8787
GATEWAY_PUBLIC_URL=http://localhost:8787
LANDING_PUBLIC_URL=http://localhost:4174
GATEWAY_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420,http://localhost:4174
DATABASE_URL=mysql://rabbit:change-me@127.0.0.1:3306/oncue_gateway

OIDC_CLIENT_ID=oncue-desktop
OIDC_REDIRECT_URI=oncuedesktop://auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=oncuedesktop://auth/logout
OIDC_SIGNING_KEYSET_FILE=/run/secrets/oidc-signing-keyset.json
OIDC_DATA_KEYRING_FILE=/run/secrets/oidc-data-keyring.json
RESEND_API_KEY=re_replace_me
RESEND_FROM=OnCue <no-reply@example.com>
# Optional Resend-compatible API override.
RESEND_API_URL=https://api.resend.com
# Only list reverse proxies that replace X-Forwarded-For.
GATEWAY_TRUSTED_PROXY_CIDRS=

HOSTED_STT_ENABLED=false
HOSTED_LLM_ENABLED=false
PAYMENTS_ENABLED=false
# Required only when PAYMENTS_ENABLED=true. Use the unarmored Base64 key strings from Alipay, not PEM files.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
GATEWAY_ADMIN_TOKEN=
VOLCENGINE_API_KEY=
VOLCENGINE_RESOURCE_ID=volc.bigasr.sauc.duration
VOLCENGINE_STT_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOLCENGINE_STT_MODELS=bigmodel
DEEPGRAM_API_KEY=
DEEPGRAM_STT_URL=wss://api.deepgram.com/v1/listen
# Required to make Deepgram selectable, for example nova-3.
DEEPGRAM_STT_MODELS=
GEMINI_API_KEY=
GEMINI_HOSTED_MODEL=gemini-3.7-flash
GEMINI_LIVE_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
# Required to make Gemini Live STT selectable.
GEMINI_STT_MODELS=
GEMINI_LLM_URL=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_LLM_MODELS=gemini-3.7-flash
OPENAI_API_KEY=
OPENAI_LLM_URL=https://api.openai.com/v1/responses
# Required to make OpenAI selectable.
OPENAI_LLM_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_URL=https://api.anthropic.com/v1/messages
# Required to make Anthropic selectable.
ANTHROPIC_LLM_MODELS=
GROQ_API_KEY=
GROQ_LLM_URL=https://api.groq.com/openai/v1/chat/completions
# Required to make Groq selectable.
GROQ_LLM_MODELS=

STT_INITIAL_HOLD_MS=60000
STT_TOP_UP_MS=60000
STT_TOP_UP_THRESHOLD_MS=15000
RESERVATION_TTL_SECONDS=120
WS_TICKET_TTL_SECONDS=30
MAX_JSON_BYTES=131072
MAX_WS_FRAME_BYTES=65536
MAX_WS_FRAMES_PER_SECOND=100
MAX_STT_SESSION_SECONDS=3600
GLOBAL_CONCURRENCY_LIMIT=100
PRICING_POLICY_VERSION=2026-09-credits-v2
