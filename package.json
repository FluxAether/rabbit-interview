{
  "name": "rabbit-interview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:audiotee": "sh scripts/build-audiotee.sh",
    "tauri:mac-audio": "npm run prepare:audiotee && tauri dev --config src-tauri/tauri.audiotee.conf.json",
    "build:mac": "sh scripts/build-audiotee.sh universal && tauri build --target universal-apple-darwin --config src-tauri/tauri.audiotee.conf.json",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "sign:mac": "echo 'Run: xcrun notarytool submit --keychain-profile \"AC_PASSWORD\" --wait dist/RabbitInterview.app.tar.gz'",
    "package": "tauri build",
    "verify:copilot": "node scripts/verify-copilot.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^18.3.0",
    "sonner": "^2.0.7",
    "wavesurfer.js": "^7.12.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.11"
  }
}
