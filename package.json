{
  "name": "oncue",
  "private": true,
  "version": "0.17.7",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "landing:dev": "vite landing",
    "landing:build": "tsc -b landing && vite build landing",
    "tauri": "tauri",
    "prepare:audiotee": "sh scripts/build-audiotee.sh",
    "prepare:gateway-keys": "node scripts/generate-gateway-keys.mjs",
    "tauri:mac-audio": "npm run prepare:audiotee && tauri dev --config src-tauri/tauri.audiotee.conf.json",
    "build:mac": "sh scripts/build-audiotee.sh universal && tauri build --target universal-apple-darwin --config src-tauri/tauri.audiotee.conf.json",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "sign:mac": "echo 'Run: xcrun notarytool submit --keychain-profile \"AC_PASSWORD\" --wait dist/OnCue.app.tar.gz'",
    "package": "tauri build",
    "verify:copilot": "node scripts/verify-copilot.mjs",
    "verify:account": "node scripts/verify-account-access.mjs",
    "verify:mock": "node scripts/verify-mock-interview.mjs",
    "verify:resume": "node scripts/verify-resume-optimizer.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:db-storage": "node scripts/verify-db-storage.mjs",
    "verify:ui-audit": "node scripts/verify-ui-audit-fixes.mjs",
    "verify:audit-fixes": "node scripts/verify-audit-fixes.mjs",
    "migrate:json-to-db": "node scripts/migrate-json-to-db.mjs",
    "stress:api": "node scripts/stress/api-stress.mjs",
    "stress:ws": "node scripts/stress/ws-stress.mjs",
    "stress:app": "node scripts/stress/app-state-stress.mjs",
    "stress:e2e": "node scripts/stress/app-client-stress.mjs",
    "stress:all": "node scripts/stress/run-all.mjs",
    "stress:notion": "node scripts/stress/upload-to-notion.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "docx": "^9.7.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.12.3",
    "motion": "13.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^18.3.0",
    "react-virtuoso": "4.18.12",
    "wavesurfer.js": "^7.12.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21"
  }
}
